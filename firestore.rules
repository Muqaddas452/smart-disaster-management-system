rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // authIndex
    // =========================
    match /authIndex/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

   // =========================
   // Citizens
   // =========================
   match /citizens/{userId} {

      allow read: if request.auth != null;

     allow create, update: if request.auth != null &&
                        request.auth.uid == userId;

    }

    // =========================
    // Admins
    // =========================
    match /admins/{userId} {
      allow read, write: if request.auth != null;
    }

    // =========================
    // Rescue Team Users
    // =========================
    match /rescueTeamUsers/{userId} {
      allow read, create, update: if request.auth != null &&
                                  request.auth.uid == userId;
    }

    // =========================
    // Team Invitations
    // =========================
    match /teamInvitations/{invitationId} {
      allow read, create, update: if request.auth != null;
    }

    // =========================
    // Manual Reports
    // =========================
    match /manual_reports/{reportId} {
      allow read, write: if true;
    }

    // =========================
    // Reports
    // =========================
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // =========================
    // Rescue Teams
    // =========================
    match /rescueTeams/{teamId} {
      allow read, write: if true;
    }

    // =========================
    // Affected Zones
    // =========================
    match /affected_zones/{zoneId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // =========================
    // Shelters
    // =========================
    match /shelters/{shelterId} {
      allow read, write: if true;
    }

    // =========================
    // Resources
    // =========================
    match /resources/{resourceId} {
      allow read, write: if true;
    }

    // =========================
    // Alerts
    // =========================
    match /alerts/{alertId} {
      allow read, write: if true;
    }
    //Broadcost Alerts
   match /broadcast_alerts/{document} {
      allow read, write: if true;
    }
    // =========================
    // Safety Tips
    // =========================
    match /safety_tips/{safety_tipID} {
      allow read, write: if true;
    }
    // =========================
    // OpenWeatherMap API
    // ==========================
    match /openweathermap/{district} {
  allow read: if request.auth != null;
  allow write: if false;
    }
    // =========================
    // Feedbacks
    // =========================
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // =========================
    // Latest Alerts
    // =========================
    match /latest_alerts/{district} {
      allow read, write: if true;
    }

  }
}