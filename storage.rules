rules_version = '2';

// Firebase Console -> Storage -> Rules tab mein ye rules paste karo.
// Ye rules sirf logged-in user ko apni hi profile picture upload/read/replace
// karne dete hain (kisi aur ki nahi).

service firebase.storage {
  match /b/{bucket}/o {
    match /profile_pictures/{fileName} {
      // koi bhi logged-in user kisi ki bhi photo read kar sake (profile screen ke liye)
      allow read: if request.auth != null;

      // sirf wo hi user apni photo upload/update kar sake jiska UID filename se match ho
      // (fileName format: "<uid>.jpg")
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024   // max 5MB
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
